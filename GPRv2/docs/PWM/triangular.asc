Version 4
SHEET 1 1400 900
WIRE -240 80 -240 96
FLAG -400 16 v12
FLAG -400 96 0
FLAG -240 0 v12
FLAG -240 176 0
FLAG -128 160 div
FLAG -240 88 div
FLAG -128 128 mid
FLAG -64 144 mid
FLAG -96 112 v12
FLAG -96 176 0
FLAG 128 -80 np
FLAG 128 -112 mid
FLAG 160 -128 v12
FLAG 160 -64 0
FLAG 192 -96 sq
FLAG 160 0 np
FLAG 240 0 sq
FLAG 160 80 np
FLAG 240 80 tri
FLAG 368 -96 sq
FLAG 448 -96 inv
FLAG 512 -192 inv
FLAG 576 -192 tri
FLAG 576 -64 inv
FLAG 576 -32 mid
FLAG 608 -80 v12
FLAG 608 -16 0
FLAG 640 -48 tri
FLAG 800 -96 dtri
FLAG 800 -16 0
SYMBOL voltage -400 0 R0
SYMATTR InstName V1
SYMATTR Value 12
SYMBOL res -256 -16 R0
SYMATTR InstName R4
SYMATTR Value 100k
SYMBOL res -256 80 R0
SYMATTR InstName R5
SYMATTR Value 100k
SYMBOL TL072 -96 80 R0
SYMATTR InstName U4
SYMBOL TL072 160 -160 R0
SYMATTR InstName U3
SYMBOL res 256 -16 R90
WINDOW 0 0 56 VBottom 2
WINDOW 3 32 56 VTop 2
SYMATTR InstName R2
SYMATTR Value 47k
SYMBOL res 256 64 R90
WINDOW 0 0 56 VBottom 2
WINDOW 3 32 56 VTop 2
SYMATTR InstName R3
SYMATTR Value 13k
SYMBOL res 464 -112 R90
WINDOW 0 0 56 VBottom 2
WINDOW 3 32 56 VTop 2
SYMATTR InstName R1
SYMATTR Value {Rs+Rpot*pos}
SYMBOL cap 576 -208 R90
WINDOW 0 0 32 VBottom 2
WINDOW 3 32 32 VTop 2
SYMATTR InstName C1
SYMATTR Value 2.2u
SYMBOL TL072 608 -112 R0
SYMATTR InstName U1
SYMBOL bv 800 -112 R0
SYMATTR InstName B1
SYMATTR Value V=ddt(V(tri))
TEXT -400 -256 Left 2 ;GPRv2 - Generador de triangular, paso 1: la topologia del PWM de Circuitos II llevada a ~10 Hz.\nU3 Schmitt, U1 integrador, U4 = VCC/2. R1 = Rs + pote (Bourns 3590), pos = posicion del pote de 0 a 1.\nB1 no es parte del circuito: da la pendiente de la triangular, para medir la linealidad.
TEXT -400 272 Left 2 !.param Rs=8.2k Rpot=100k\n.step param pos list 0 0.25 0.5 0.75 1\n.tran 0 1.6 0 20u\n.options plotwinsize=0
TEXT -400 400 Left 2 !.meas tran t1 WHEN V(sq)=6 RISE=3\n.meas tran t2 WHEN V(sq)=6 RISE=4\n.meas tran tb WHEN V(sq)=6 FALL=1 TD=t1\n.meas tran periodo PARAM t2-t1\n.meas tran frec PARAM 1/periodo\n.meas tran t_baja PARAM tb-t1\n.meas tran t_sube PARAM t2-tb\n.meas tran asimetria PARAM t_sube/t_baja\n.meas tran vmax MAX V(tri) FROM t1 TO t2\n.meas tran vmin MIN V(tri) FROM t1 TO t2\n.meas tran vpp PARAM vmax-vmin\n.meas tran vcentro PARAM (vmax+vmin)/2\n.meas tran sq_alto AVG V(sq) FROM t1+0.1*t_baja TO t1+0.9*t_baja\n.meas tran sq_bajo AVG V(sq) FROM tb+0.1*t_sube TO tb+0.9*t_sube\n.meas tran fl_a WHEN V(sq)=2 RISE=1 TD=tb+0.5*t_sube\n.meas tran fl_b WHEN V(sq)=10 RISE=1 TD=tb+0.5*t_sube\n.meas tran flanco PARAM fl_b-fl_a
TEXT 480 272 Left 2 !.meas tran ps_max MAX V(dtri) FROM tb+0.1*t_sube TO tb+0.9*t_sube\n.meas tran ps_min MIN V(dtri) FROM tb+0.1*t_sube TO tb+0.9*t_sube\n.meas tran ps_avg AVG V(dtri) FROM tb+0.1*t_sube TO tb+0.9*t_sube\n.meas tran nolin_sube PARAM 100*(ps_max-ps_min)/ps_avg\n.meas tran pb_max MAX V(dtri) FROM t1+0.1*t_baja TO t1+0.9*t_baja\n.meas tran pb_min MIN V(dtri) FROM t1+0.1*t_baja TO t1+0.9*t_baja\n.meas tran pb_avg AVG V(dtri) FROM t1+0.1*t_baja TO t1+0.9*t_baja\n.meas tran nolin_baja PARAM 100*(pb_min-pb_max)/pb_avg\n.meas tran ps_ref AVG V(dtri) FROM tb+0.1*t_sube TO tb+0.5*t_sube\n.meas tran v50s FIND V(tri) AT tb+0.5*t_sube\n.meas tran redondeo_arriba_mV PARAM 1000*(v50s+ps_ref*(t2-tb-0.5*t_sube)-vmax)\n.meas tran pb_ref AVG V(dtri) FROM t1+0.1*t_baja TO t1+0.5*t_baja\n.meas tran v50b FIND V(tri) AT t1+0.5*t_baja\n.meas tran redondeo_abajo_mV PARAM 1000*(vmin-v50b-pb_ref*(tb-t1-0.5*t_baja))
TEXT 480 -256 Left 2 ;Mediciones (View > SPICE Error Log, Ctrl+L), una fila por posicion del pote:\n  periodo, frec     sobre la cuadrada (U3)\n  asimetria         t_sube / t_baja; 1 = simetrica\n  vpp, vcentro      de la triangular\n  sq_alto, sq_bajo  niveles de la cuadrada\n  flanco            lo que dura el flanco de la cuadrada = lo que dura el vertice\n  nolin_sube/baja   variacion de la pendiente en el 80 % central de la rampa [%]\n  redondeo_*_mV     cuanto le falta al vertice respecto de la recta del tramo 10-50 %
